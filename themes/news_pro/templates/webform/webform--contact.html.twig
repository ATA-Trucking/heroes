<form{{ attributes }}>
	<div class="row gx-4">
	    <div class="col-12  mb-3">
	        {{ element.elements.name }}
	    </div>
	    <div class="col-12 mb-3">
	        {{ element.elements.e_mail }}
	    </div>
	    <div class="col-12">
	        {{ element.elements.message }}
	    </div>
	</div>
	{{ element.elements.actions }}
	{{ element.form_build_id }}
	{{ element.form_token }}
	{{ element.form_id }}
</form>
