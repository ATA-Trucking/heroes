    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-lg-9 col-md-10 col-sm-10 text-center">
            <div class="footer-logo">
                {% if footer_logo_url %}
                    <a href="{{base_url}}"><img src="{{footer_logo_url}}" title="logo" alt="logo" /></a>
                {% else %}
                    <a href="{{base_url}}" class="footer-logo">
