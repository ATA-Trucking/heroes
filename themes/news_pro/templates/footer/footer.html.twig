                    </a>
                {% endif %}
            </div>
            {% if c_description %}
            <div class="footer-content">
                <p>{{c_description}}</p>
            </div>
            {% endif %}
        </div>
    </div>
    <div class="footer-hr">
      <hr>
    </div>
    <div class="row gx-6">
        {% if page.footer_first %}
        <div class="col-sm-10 col-md-6 col-lg-5 col-12">
            {{page.footer_first}}
        </div>
        {% endif %}	
        {% if page.footer_second %}
        <div class="col-sm-10 col-md-5 col-lg-2 col-12 mt-sm-4 mt-3 mt-md-0">
            {{page.footer_second}}
        </div>
        {% endif %}	
        {% if page.footer_third %}
        <div class="col-sm-10 col-md-6 col-lg-5 col-12 mt-md-5 mt-sm-4 mt-3 mt-lg-0">
            {{page.footer_third}}
        </div>
        {% endif %}	
      </div>
    </div>
  </div>
</footer>
{# --- Copyrights --- #}
<section class="sec-pad-20 copy-rights">
    <div class="container">
        <div class="row"> 
            {% if page.footer_fourth %}
            <div class="col-12 col-md-6 terms order-md-last">
                {{ page.footer_fourth }}
            </div>
            {% endif %} 
            <div class="copy col-12 col-md-6 order-md-first">
                <small>{{copyrights|raw}}</small>
            </div>
        </div>      
    </div>
</section>