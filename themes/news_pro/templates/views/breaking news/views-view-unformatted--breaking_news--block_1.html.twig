<section id="header-1-news-ticker">
	<div class="container">
		<div class="d-lg-flex d-md-block justify-lg-content-between   align-items-center">
			<div class="header-1-news-ticker-title">
				<h6>{{view.getTitle()}}</h6> 
			</div>
			<div class="header-1-news-ticker-wapper">
				<div class="owl-carousel owl-theme owl-loaded news-ticker">
					{% for row in rows %}
						{{ row.content }}
					{% endfor %}
				</div>		
			</div>
		</div>
	</div>
</section>