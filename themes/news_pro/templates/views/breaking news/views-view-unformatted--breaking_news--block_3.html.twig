<section id="header-3-news-ticker">
	<div class="container">
		<div class="d-lg-flex d-md-block justify-content-lg-between align-items-center">
			<div class="header-1-news-ticker-title">
				<h6>{{view.getTitle()}}</h6>
			</div>
			<div class="header-1-news-ticker-wapper">
				<div class="owl-carousel owl-theme owl-loaded news-ticker">
				{% for row in rows %}
					{{ row.content }}
				{% endfor %}
				</div>
			</div>
			<div class="header-2-search">
				<div class="header-1-menu-right">
					<div class="searchbar-1">
						<i><svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24.05 24.04"><title>search</title><path d="M17.74,16.33a10,10,0,1,0-1.41,1.41l6,6a1,1,0,0,0,1.41,0h0a1,1,0,0,0,0-1.41h0ZM10,18a8,8,0,1,1,8-8A8,8,0,0,1,10,18Z" transform="translate(0 0)"></path></svg></i>
					</div>
					<div class="togglesearch-item">
						<div class="togglesearch-1">
							<form action="{{base_url}}/search/node" method="get">
								<input type="text" class="search-input" placeholder="Enter keyword" name="keys">
								<button type="submit" class="btn btn-primary">
									<svg xmlns="http://www.w3.org/2000/svg" width="45.988" height="46" viewBox="0 0 45.988 46">
										<path d="M49.949,47.163l-12.79-12.91a18.227,18.227,0,1,0-2.766,2.8L47.1,49.882a1.968,1.968,0,0,0,2.778.072A1.981,1.981,0,0,0,49.949,47.163ZM22.835,37.211A14.393,14.393,0,1,1,33.015,33,14.3,14.3,0,0,1,22.835,37.211Z" transform="translate(-4.5 -4.493)" fill="#fff"></path>
									</svg>
								</button>
							</form>
						</div>
					</div>
				</div>
			</div>      	
		<div>
	</div>
</section>