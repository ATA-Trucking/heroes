{% if fields.counter.content == '1' %}
<div class="tab-style-2-content-wapper">
    <div class="tab-style-2-img">
        <a href="{{ fields.view_node.content }}" title="Tabs"><img src="{{ fields.field_image.content}}" class="img-fluid" alt="{{ fields.field_image_1.content }}" /></a>
    </div>
    <div class="tab-style-2-content">
        <h6><span>{{ fields.field_categories.content }}</span> {{ fields.created.content }}</h6>
        <a href="{{ fields.view_node.content }}" title="{{ fields.title.content }}"><h3>{{ fields.title.content }}</h3> </a>
        <a href="{{ fields.view_node.content }}" title="Read More" class="text-link-with-icon">Read More <i><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 694.78 296.45"><defs></defs><title>right_arrow</title><path d="M766.22,442.74l-169,123c-19,12-29,5-31-16v-88h-459a31.16,31.16,0,0,1-31-31h0a31.16,31.16,0,0,1,31-31h459v-96c1-30,11-34,31-23l168,140C772.22,426.74,773.22,433.74,766.22,442.74Z" transform="translate(-76.22 -275.15)"></path></svg></i></a>
    </div>
</div>
{% else %}
<div class="mt-2 mb-4 col-12 col-md-6 col-lg-4">
