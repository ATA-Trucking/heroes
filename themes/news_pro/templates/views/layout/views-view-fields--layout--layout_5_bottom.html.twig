<div class="col-12 col-md-6 col-lg-4  wow fadeInLeft" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
    <div class="home-5-feature-box">
        <div class="home-5-feature-box-img">
            <a href="{{ fields.view_node.content}}" title="{{ fields.created.content }}"><img src="{{ fields.field_image.content}}" class="img-fluid" alt="{{ fields.field_image_1.content }}" /></a>
        </div> 
        <div class="home-5-feature-box-content">
            <a href="{{ fields.view_node.content}}" title="{{ fields.title.content }}"><h5>{{ fields.title.content }}</h5></a>
            <h6>{{fields.created.content}}<span class="dot"></span> {{ fields.totalcount.content }} {{ fields.nothing.content }} <span class="dot"></span> {{ fields.uid.content }} </h6> 
        </div>
        <div class="home-5-feature-box-tag">
            <h6>{{ fields.field_categories.content }}</h6>
        </div>
    </div>
</div>
