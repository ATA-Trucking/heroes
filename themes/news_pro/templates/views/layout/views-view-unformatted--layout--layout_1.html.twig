<section class="home-banner-1 sec-pad-b-180 wow fadeInLeft" id="carousels-2" data-wow-duration=".75s" data-wow-delay=".15s">
	<div class="container">
		<div class="row justify-content-center align-items-center">
			<div class="col-12">
				<div class="owl-carousel owl-theme owl-nav-right carousels-2">
					{% for row in rows %}
						{% if loop.index % 5 == 1 %}
						<div class="item">
							<div class="row justify-content-center align-items-center gx-2">
								<div class="col-12 col-md-6 col-lg-6">
									{{row.content}}
								</div>
						{% elseif loop.index % 5 == 2 %}
								<div class="col-12 col-md-6 col-lg-6">
									{{row.content}}
								</div>
						{% elseif loop.index % 5 == 3 %}
								<div class="col-12 col-md-6 col-lg-4">
									{{row.content}}
								</div>
						{% elseif loop.index % 5 == 4 %}
								<div class="col-12 col-md-6 col-lg-4">
									{{row.content}}
								</div>
						{% elseif loop.index % 5 == 0 or loop.last %}
								<div class="col-12 col-md-6 col-lg-4">
									{{row.content}}
								</div>
							</div>
						</div>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>
	