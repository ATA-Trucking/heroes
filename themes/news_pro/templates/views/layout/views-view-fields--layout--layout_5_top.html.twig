<div class="item">
    <div class="home-5-banner-wapper">
        <div class="home-5-banner-img">
            <img src="{{ fields.field_image.content}}" alt="{{ fields.field_image_1.content}}">
        </div>
        <div class="home-5-banner-content">
            <h5>{{ fields.field_categories.content }}</h5>
            <a href="{{ fields.view_node.content}}" title="{{ fields.title.content }}"><h3>{{ fields.title.content }}</h3></a>
            <h6>{{ fields.created.content }}<span class="dot"></span> {{fields.totalcount.content }} {{fields.nothing.content}} <span class="dot"></span> {{ fields.uid.content }} </h6> 
            <div class="banner-btn" >
                <a href="{{ fields.view_node.content}}" class="btn btn-md btn-secondary" title="{{ fields.nothing_1.content }} ">{{ fields.nothing_1.content }}</a>
            </div>
        </div>
    </div>
</div>