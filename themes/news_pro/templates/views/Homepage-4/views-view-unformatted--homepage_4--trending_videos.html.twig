<div class="home-4-trending-video">
	<div class="row">
		{% for row in rows %}
			{% if loop.index % 3 == 1 %}
				{% if loop.first %}
				<div class="col-12 col-md-12 col-lg-9 wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
					{{ row.content }}
				</div>
				{% else %}
				<div class="col-12 col-md-12 col-lg-9 mt-3 wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
					{{ row.content }}
				</div>
				{% endif %}
			{% else %}
				{% if loop.index % 3 == 2 %}
                <div class="col-12 col-lg-3">
					{{row.content}}
					{% if loop.last %}
						</div>
					{% endif %}
				{% elseif loop.index % 3 == 0 %}
					{{row.content}}
				</div>
				{% endif %}
			{% endif %}
		{% endfor %}
	</div>
</div>