{% if fields.field_background_image.content %}
<section class="banner d-flex justify-content-center align-items-center" style="background-image: url({{ fields.	field_background_image.content}});">
	<div class="container"> 
		<div class="banner-text text-center">
			<h2>{{ fields.name.content}}</h2>
		</div> 
	</div>
</section>
{% else %}
<section class="banner d-flex justify-content-center align-items-center">
	<div class="container"> 
		<div class="banner-text text-center">
			<h2>{{ fields.name.content}}</h2>
		</div> 
	</div>
</section>
{% endif %}