{% if fields.field_banner.content %}
<section class="banner d-flex justify-content-center align-items-center" style="background-image: url({{ fields.field_banner.content}});">
	<div class="container"> 
	      <div class="banner-text text-center">
	         <h2>{{ fields.field_banner_title.content}}</h2>
	      </div> 
	</div>
</section>
{% else %}
<section class="banner d-flex justify-content-center align-items-center">
	<div class="container"> 
	      <div class="banner-text text-center">
	         <h2>{{ fields.field_banner_title.content}}</h2>
	      </div> 
	</div>
</section>
{% endif %}