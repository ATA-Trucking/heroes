<div class="post-classic-wapper">
	<div class="row">
		<div class="col-2 col-lg-1 wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
			<h4>{{view.getTitle()}}</h4>
		</div>
		<div class="col-10 col-lg-11 wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
			<div class="post-classic-tags">
				<ul>
					{% for row in rows %}
						{{ row.content }}
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>