{% set base_url = url('<front>')  %}
<section class="sec-pad-90" id="register">
  <div class="container">
      <div class="row justify-content-center align-items-center">
           <div class="col-12 col-lg-8">
               <div class="wapper-login-reister">
                   <div class="login-reister-title">
                       <h2>{{register_title}}</h2>
                       <p>{{register_content}}</p>
                   </div>
                   <div class="form-3 mt-5 mb-">
                      <form action="#" method="post">
                          <div class="row g-4">
                              <div class="col-12 col-md-12">
                                {{ form.account.mail }}
                                <small class="text-muted">Enter your valid Email address.</small>
                              </div>
                              <div class="col-12 col-md-12">
                                {{ form.account.name }}
                              </div>
                            </div>
                            <div class="d-lg-flex d-block  align-items-center  mt-5">
                                {{ form.actions }}
                            <div>
                            <a href="{{ base_url }}user/login" title="login" class="forgot-pwd">Already Have an Account? <span>Login</span></a>
                            </div>
                          </div>
                          {{ form.form_build_id }}
                          {{ form.form_id }}
                      </form>
                  </div>
               </div>
           </div>
      </div>
  </div> 
</section>