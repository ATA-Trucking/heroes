{% if paragraph.field_style.value == 'style-1' %}
	{% if content.field_title.0 %}
		<h3>{{content.field_title.0}}</h3>
	{% endif %}
{% elseif paragraph.field_style.value == 'style-2' %}
	{% if content.field_title.0 %}
		<h3>{{content.field_title.0}}</h3>
	{% endif %}
{% elseif paragraph.field_style.value == 'style-3' %}
	{% if content.field_formatted_title.0 %}
		<div class="row">
			<div class="col-12 mx-auto text-left mb-4">
				<div class="title-style-3">
					<h3 class="mb-0">{{content.field_formatted_title.0}}</h3>
				</div>
			</div>
		</div>
	{% endif %}
{% else %}
<div class="sidebar-style-5" id="subscribe">
	<div class="sidebar"  id="subscribe-side">
		{% if content.field_title.0 %}
		<div class="sidebar-title">
			<h5><span>{{content.field_title.0}}</span></h5> 
		</div>
		{% endif %}
		{% if content.field_description.0 %}
			<h6>{{content.field_description.0}}</h6>
		{% endif %}
		{{content.field_form}}
	</div>
</div>
{% endif %}