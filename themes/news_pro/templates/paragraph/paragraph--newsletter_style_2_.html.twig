 <section class="sec-pad-80 wow fadeInUp" data-wow-duration=".75s" data-wow-delay=".15s" id="newsletter-style-2" style="background-image: url('{{file_url(content.field_background_image['#items'].entity.uri.value)}}')">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-12 col-lg-6 text-center">
                <div class="news-letter-title">
                    <h2>{{content.field_title.0}}</h2> 
                    <p>{{ content.field_description.0 }}</p>
                </div>
            </div>
            <div class="col-12 mt-4">
                <div class="news-letter-form">
                    {{ content.field_form.0 }}
                </div>
            </div>
        </div> 
    </div>
</section>