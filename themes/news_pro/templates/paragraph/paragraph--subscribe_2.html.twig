{% if paragraph.field_style.value == 'style-1' %}
	{% if content.field_title.0 %}
		<h3>{{content.field_title.0}}</h3>
	{% endif %}
{% elseif paragraph.field_style.value == 'style-2' %}
	{% if content.field_title.0 %}
		<h3>{{content.field_title.0}}</h3>
	{% endif %}
{% elseif paragraph.field_style.value == 'style-3' %}
	{% if content.field_formatted_title.0 %}
		<div class="row">
			<div class="col-12 mx-auto text-left mb-4">
				<div class="title-style-3">
					<h3 class="mb-0">{{content.field_formatted_title.0}}</h3>
				</div>
			</div>
		</div>
	{% endif %}
{% else %}
<div class="sidebar-style-4">
	<div class="home-4">
		{% if content.field_title.0 %}
			<div class="tab-style-1-wapper">
				<div class="home-4-title wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
					<h2>{{content.field_title.0}}</h2>
				</div>
			</div>
			<div>
				<hr>
			</div>
		{% endif %}
	</div>
	<div class="home-4-subscribe wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;"> 
	{% if content.field_description.0 %}
		<p>{{content.field_description.0}}</p>
	{% endif %}
	{{content.field_form}}
	</div>
</div>
{% endif %}