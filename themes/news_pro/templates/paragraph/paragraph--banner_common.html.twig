{% if content.field_background_image %}
<section class="banner d-flex justify-content-center align-items-center" style="background-image: url({{ file_url(content.field_background_image['#items'].entity.uri.value) }});">
	<div class="container"> 
		<div class="banner-text text-center">
			<h2>{{content.field_title.0}}</h2>
		</div> 
	</div>
</section>
{% else %}
<section class="banner d-flex justify-content-center align-items-center">
	<div class="container"> 
		<div class="banner-text text-center">
			<h2>{{content.field_title.0}}</h2>
		</div> 
	</div>
</section>
{% endif %}
<!-- End of Banner -->



