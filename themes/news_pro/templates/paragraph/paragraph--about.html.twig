<section class="sec-pad-t-100 sec-pad-b-10 " id="about-us">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 text-center">
                <div class="about wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
                    <h1>{{content.field_title.0}}</h1>
                </div>
                <div class="about-img wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
                <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}" alt="{{ content.field_image['#items'].alt }}" title="{{ content.field_image['#items'].title }}" />
                </div>
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
                    <div class="about-content">
                        <p>{{ content.field_description.0 }}</p>
                    </div>
                </div>
            </div>
            {% if content.field_social_links[0] %}
            <div class="about-social wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".15s" style="visibility: visible; animation-duration: 0.5s; animation-delay: 0.15s;">
                <ul>
                {{ content.field_social_links }}
                </ul>
            </div>
            {% endif %}
            <a href="{{ content.field_link.0['#url'] }}" title="{{ content.field_link.0['#title']}}" class="btn btn-primary">{{ content.field_link.0['#title']}}</a>
            </div>
        </div>
    </div>
</section>
<div class="container">
    <hr>
</div>
   
  