{% import _self as menus %}

{#
  We call a macro which calls itself to render the full tree.
  @see http://twig.sensiolabs.org/doc/tags/macro.html
#}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
    {% if menu_level == 0 %}
      <ul class="navbar-nav">
          {% if items %}
            {% for item in items %}
              {% if item.below %}
                {%
                    set classes = [
                      'nav-link  dropdown-toggle' ,
                      item.in_active_trail ? 'active',
                    ]
                  %}  
                <li class="nav-item dropdown">
                  {% if item.url.toString|length == 0 %}
                  <span {{ item.attributes.addClass(classes)}} href="{{ item.url }}" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                   {{ item.title }}<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.96 17.27"><path d="M50,58.62h0A2.24,2.24,0,0,1,48.43,58L35.64,45.18A2.24,2.24,0,1,1,38.79,42h0L50,53.25,61.21,42a2.23,2.23,0,0,1,3.15,3.15L51.57,58A2.24,2.24,0,0,1,50,58.62Z" transform="translate(-34.98 -41.35)" /></svg>
                  </span>
                  {% else %}
                  <a {{ item.attributes.addClass(classes)}} title="{{item.title}}" href="{{ item.url }}" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">
                   {{ item.title }}<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.96 17.27"><path d="M50,58.62h0A2.24,2.24,0,0,1,48.43,58L35.64,45.18A2.24,2.24,0,1,1,38.79,42h0L50,53.25,61.21,42a2.23,2.23,0,0,1,3.15,3.15L51.57,58A2.24,2.24,0,0,1,50,58.62Z" transform="translate(-34.98 -41.35)" /></svg>
                  </a>
                  {% endif %}
                  <ul class="dropdown-menu dropdown-submenu">
                    {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
                  </ul>
                </li>
              {% else %}
                {%
                    set classes = [
                      'nav-link' ,
                      item.in_active_trail ? 'active',
                    ]
                  %}
                <li class="nav-item">
                  {% if item.url.toString|length == 0 %}
                  <span {{ item.attributes.addClass(classes)}} href="{{ item.url }}">{{ item.title }}</span>
                  {% else %}
                  <a {{ item.attributes.addClass(classes)}} href="{{ item.url }}">{{ item.title }}</a>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          {% endif %}
        </ul>
    {% elseif menu_level == 1 %}
      {% if items %}
          {% for item in items %}
            {% if item.below %}
              <li class="dropend">
              {% if item.url.toString|length == 0 %}
              <span class="dropdown-item dropdown-toggle dropdown-submenu-toggle" href="{{ item.url }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="{{item.title}}" aria-expanded="false">{{ item.title }}<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.96 17.27"><path d="M50,58.62h0A2.24,2.24,0,0,1,48.43,58L35.64,45.18A2.24,2.24,0,1,1,38.79,42h0L50,53.25,61.21,42a2.23,2.23,0,0,1,3.15,3.15L51.57,58A2.24,2.24,0,0,1,50,58.62Z" transform="translate(-34.98 -41.35)" /></svg></span>
                    <ul class="dropdown-menu dropdown-submenu">
                      {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
                    </ul>
              {% else %}
              <a class="dropdown-item dropdown-toggle dropdown-submenu-toggle" href="{{ item.url }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="{{item.title}}" aria-expanded="false">{{ item.title }}<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.96 17.27"><path d="M50,58.62h0A2.24,2.24,0,0,1,48.43,58L35.64,45.18A2.24,2.24,0,1,1,38.79,42h0L50,53.25,61.21,42a2.23,2.23,0,0,1,3.15,3.15L51.57,58A2.24,2.24,0,0,1,50,58.62Z" transform="translate(-34.98 -41.35)" /></svg></a>
                    <ul class="dropdown-menu dropdown-submenu">
                      {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
                    </ul>
              {% endif %}
              </li>
            {% else %}
            <li>
            {% if item.url.toString|length == 0 %}
            <span href="{{ item.url }}" class="dropdown-item ">{{ item.title }}</span>
            {% else %}
            <a href="{{ item.url }}" class="dropdown-item ">{{ item.title }}</a>
            {% endif %}
            </li>
            {% endif %}
          {% endfor %}
      {% endif %}
    {% elseif menu_level == 2 %}
        {% if items %}
          {% for item in items %}
            {% if item.below %}
              <li class="dropend">
              {% if item.url.toString|length == 0 %}
              <span href="{{ item.url }}">{{ item.title }}<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.96 17.27"><path d="M50,58.62h0A2.24,2.24,0,0,1,48.43,58L35.64,45.18A2.24,2.24,0,1,1,38.79,42h0L50,53.25,61.21,42a2.23,2.23,0,0,1,3.15,3.15L51.57,58A2.24,2.24,0,0,1,50,58.62Z" transform="translate(-34.98 -41.35)" /></svg></span>
                    <ul class="dropdown-menu dropdown-submenu">
                      {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
                    </ul>
              {% else %}
              <a href="{{ item.url }}">{{ item.title }}<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.96 17.27"><path d="M50,58.62h0A2.24,2.24,0,0,1,48.43,58L35.64,45.18A2.24,2.24,0,1,1,38.79,42h0L50,53.25,61.21,42a2.23,2.23,0,0,1,3.15,3.15L51.57,58A2.24,2.24,0,0,1,50,58.62Z" transform="translate(-34.98 -41.35)" /></svg></a>
                    <ul class="dropdown-menu dropdown-submenu">
                      {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
                    </ul>
              {% endif %}
              </li>
            {% else %}
            <li>
            {% if item.url.toString|length == 0 %}
              <span href="{{ item.url }}" title="{{item.title}}" class="dropdown-item">{{ item.title }}</span>
            {% else %}
              <a href="{{ item.url }}" title="{{item.title}}" class="dropdown-item">{{ item.title }}</a>
            {% endif %}
            </li>
            {% endif %}
          {% endfor %}
        {% endif %}
    {% elseif menu_level == 3 %}
        {% if items %}
          {% for item in items %}
            <li class="dropdown-item">
            {% if item.url.toString|length == 0 %}
              <span href="{{ item.url }}">{{ item.title }}</span>
            {% else %}
              <a href="{{ item.url }}">{{ item.title }}</a>
            {% endif %}
            </li>
          {% endfor %}
        {% endif %}
    {% endif %}
{% endmacro %}
