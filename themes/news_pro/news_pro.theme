<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Url;
use Drupal\file\Entity\File;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
/**
 * Implements hook_theme().
 */
function news_pro_theme(&$existing, $type, $theme, $path) {
  $variables['login_title'] = theme_get_setting('login_title'); 
   $hooks = array();
   $hooks['user_login_form'] = array(
    'render element' => 'form',
    'template' => 'user-login-form',
    'preprocess functions' => array(
       'news_pro_preprocess_user_login'
    ),
   );
   $hooks['user_register_form'] = array(
    'render element' => 'form',
    'template' => 'user-register-form',
    'preprocess functions' => array(
       'news_pro_preprocess_user_register'
    ),
   );
   $hooks['user_pass'] = array(
    'render element' => 'form',
    'template' => 'user-pass-form',
    'preprocess functions' => array(
       'news_pro_preprocess_user_pass'
    ),
   );
   return $hooks; 
}
/**
 * Implements hook_form_alter().
 */
function news_pro_form_alter( &$form, &$form_state, $form_id ) {
  
  if ($form_id == 'user_login_form') {
    $form['actions']['submit']['#value'] = t('Login');
    $form['actions']['submit']['#attributes']['class'][]='btn btn-sm btn-secondary';
    $form['name']['#attributes']['autofocus']='none';
  }
  if ($form_id == 'user_register_form') {
    $form['actions']['submit']['#value'] = t('Register');
    $form['actions']['submit']['#attributes']['class'][]='btn btn-sm btn-secondary';
  }
  if ($form_id == 'user_pass') {
    $form['actions']['submit']['#value'] = t('Reset');
    $form['actions']['submit']['#attributes']['class'][]='btn btn-sm btn-secondary';
  }
}
/**
 * Implements hook_preprocess_user_login().
 */
function news_pro_preprocess_user_login(&$variables) {
  $variables['login_title'] = theme_get_setting('login_title');
  $variables['login_content'] = theme_get_setting('login_content');
}
/**
 * Implements hook_preprocess_user_register().
