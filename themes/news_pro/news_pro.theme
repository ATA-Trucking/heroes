  $variables['register_content'] = theme_get_setting('register_content');
}
/**
 * Implements hook_preprocess_user_pass().
 */
function news_pro_preprocess_user_pass(&$variables) {
  $variables['r_pass_title'] = theme_get_setting('r_pass_title');
  $variables['r_pass_content'] = theme_get_setting('r_pass_content');
}
